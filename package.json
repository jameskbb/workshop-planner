{
  "name": "workshop-planner",
  "version": "0.1.0",
  "description": "Local-first, desktop-first planner for garages and workshops: exact room modelling, clearance and vehicle checks, layout comparison, 3D, printable plans and a physical move plan.",
  "license": "MIT",
  "author": "James Krape (jameskbb)",
  "homepage": "https://github.com/jameskbb/workshop-planner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameskbb/workshop-planner.git"
  },
  "bugs": {
    "url": "https://github.com/jameskbb/workshop-planner/issues"
  },
  "keywords": [
    "garage",
    "workshop",
    "floor-plan",
    "layout",
    "cad",
    "woodworking",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
